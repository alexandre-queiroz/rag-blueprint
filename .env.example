# Chroma Cloud — https://trychroma.com
# Get your credentials at: Settings > API Keys
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-api-key-here
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=dev

# Redis Cloud — https://redis.io/try-free
# Get your credentials at: Databases > [your database] > Configuration > Connect
REDIS_HOST=your-host.db.redis.io
REDIS_PORT=your-port
REDIS_USERNAME=default
REDIS_PASSWORD=your-password-here

# Axiom — https://axiom.co
# Get your credentials at: Settings > API Tokens
AXIOM_API_KEY=your-api-key-here
AXIOM_DATASET=rag-blueprint

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Google — https://aistudio.google.com
GOOGLE_API_KEY=your-api-key-here

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=your-api-key-here
